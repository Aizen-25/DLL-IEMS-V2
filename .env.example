# Example environment variables (do NOT commit real secrets)
# Copy this file to `.env` and replace placeholders with real values for local development.

SESSION_SECRET=REPLACE_WITH_64+_BYTE_SECRET_HEX_OR_BASE64
# Example DATABASE_URL (for direct DATABASE_URL use):
# DATABASE_URL=postgresql://user:password@localhost:5432/inventory_development

# Or use DB_HOST/DB_USER/DB_PASS/DB_NAME for docker-compose local setup
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=inventory_development

# Optional: a legacy DB to transfer from during deploy
# LEGACY_DATABASE_URL=postgresql://user:password@host:5432/legacy_db

RACK_ENV=development
