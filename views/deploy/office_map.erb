<style>
  .office-map-wrap { display:flex; gap:12px; align-items:stretch }
  .map-canvas { background:#e9e9e9; width:100%; height:calc(100vh - 220px); min-height:420px; border-radius:12px; position:relative; overflow:hidden; border:6px solid rgba(0,0,0,0.04) }
  .office-pill { display:inline-block; background:#4b5563; color:#fff; padding:12px 28px; border-radius:30px; font-weight:700; margin-bottom:12px }
  .toolbar { width:92px; background:rgba(0,0,0,0.06); border-radius:14px; padding:12px; display:flex; flex-direction:column; gap:12px; align-items:center }
  .tool-icon { width:56px; height:56px; border-radius:10px; background:#fff; display:flex; flex-direction:column; align-items:center; justify-content:center; cursor:grab; box-shadow:0 6px 18px rgba(0,0,0,0.08); padding:6px }
  .tool-icon svg { width:26px; height:26px; display:block }
  .tool-icon .tool-img { width:28px; height:28px; display:block }
  .tool-label { display:none; font-size:0.78rem; color:var(--muted); margin-top:6px; text-align:center }
  .map-icon { position:absolute; width:44px; height:44px; border-radius:8px; background:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer; box-shadow:0 6px 18px rgba(0,0,0,0.12); transform:translate(-50%,-50%); padding:6px }
  .map-icon svg { width:22px; height:22px }
  .map-icon .map-img { width:22px; height:22px; display:block }
  .map-icon .badge { position:absolute; right:-6px; top:-6px; width:12px; height:12px; border-radius:50%; background:#bbb; border:2px solid #fff }
  .map-icon.assigned .badge { background:#57a773 }
  .map-icon.unassigned .badge { background:#cbd5e1 }
  .map-label { position:absolute; left:110%; top:50%; transform:translateY(-50%); background:rgba(255,255,255,0.95); color:#07101a; padding:6px 8px; border-radius:6px; box-shadow:0 8px 24px rgba(0,0,0,0.12); white-space:nowrap; display:none; font-size:0.8rem }
  .map-icon.selected { box-shadow: 0 0 0 4px rgba(99,102,241,0.12); border:2px solid rgba(99,102,241,0.18); }
  /* show label on hover */
  .map-icon:hover .map-label { display:block }
  .tool-icon:hover .tool-label { display:block }

  /* on narrow screens always show palette labels and map labels inline */
  @media (max-width: 820px) {
    .toolbar { width:100%; flex-direction:row; padding:8px; overflow:auto }
    .tool-icon { width:64px; height:64px; margin-right:6px }
    .tool-label { display:block }
    .map-label { display:block; left:calc(100% + 8px) }
  }
  .map-icon.assigned { border:3px solid #57a773 }
  .tiny-panel { position:absolute; background:#fff; border-radius:8px; padding:8px; box-shadow:0 12px 40px rgba(0,0,0,0.2); z-index:4000 }
  .toast { position:fixed; right:18px; bottom:18px; background:#111; color:#fff; padding:10px 14px; border-radius:8px; opacity:0.95 }
</style>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px">
  <h2 style="margin:0">Office virtualization</h2>
  <div>
    <span class="office-pill"><%= h @office_slug %></span>
  </div>
</div>

<div class="office-map-wrap">
  <div style="flex:1">
    <div id="mapCanvas" class="map-canvas" role="application" aria-label="Office map">
      <div id="mapInner" style="position:absolute; inset:0; transform-origin:0 0;"></div>
      <div id="mapOverlay" style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none; color:#777">Drop icons here to place equipment</div>
    </div>
  </div>
  <aside style="width:180px; max-width:220px">
    <div style="display:flex; gap:12px; align-items:center; margin-bottom:8px"><strong>Available devices</strong></div>
    <div class="toolbar" id="toolbar" aria-label="Palette">
      <% # Fixed palette of common network / office devices so user can drag icons regardless of office inventory %>
      <% palette = ['Laptop','Desktop','Router','Switch','Printer'] %>
      <% palette.each do |t| %>
        <% fname = t.downcase.gsub(' ', '-') %>
        <div class="tool-icon" draggable="true" data-type="<%= h t %>" title="<%= h t %>">
          <img class="tool-img" src="/icons/<%= fname %>.svg" alt="<%= h t %>" onerror="this.style.display='none'" />
          <div class="tool-label"><%= h t %></div>
        </div>
      <% end %>
      <div style="font-size:0.85rem;color:var(--muted);margin-top:8px;text-align:center">Drag icons onto the map</div>
    </div>
    <div style="margin-top:14px">
      <strong>Deployed equipment</strong>
      <div id="deployedList" style="margin-top:8px; max-height:380px; overflow:auto; background:transparent; padding-right:6px">
        <% if defined?(@office_assigned_units) && @office_assigned_units.any? %>
          <% @office_assigned_units.each do |ue| %>
            <div class="muted" data-eid="<%= ue.equipment_id %>" data-ueid="<%= ue.id %>" data-user="<%= h ue.assigned_username %>">
              <strong><%= h(ue.equipment_name) %></strong>
              <div style="font-size:0.85rem;color:var(--muted)">serial: <%= h(ue.serial) %> — assigned to <%= h(ue.assigned_username) %></div>
            </div>
          <% end %>
        <% end %>
        <% @office_equipments.each do |eq| %>
          <div class="muted" data-eid="<%= eq.id %>"><%= h(eq.name) %> <span style="color:var(--muted)">(<%= h eq.serial_number %>)</span></div>
        <% end %>
      </div>
    </div>
  </aside>
</div>

<div id="toast" style="display:none" class="toast">Saved</div>

<script>
// Office virtualization functions removed. New features will be
// implemented here. Keep this script as a placeholder so the view
// can be enhanced with new client-side code later.
console.info('Office virtualization client functions removed (placeholder).');
</script>
