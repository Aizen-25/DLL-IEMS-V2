<style>
  .office-map-wrap { display:flex; gap:12px; align-items:stretch }
  .map-canvas { background:#e9e9e9; width:100%; height:calc(100vh - 220px); min-height:420px; border-radius:12px; position:relative; overflow:hidden; border:6px solid rgba(0,0,0,0.04) }
  .office-pill { display:inline-block; background:#4b5563; color:#fff; padding:12px 28px; border-radius:30px; font-weight:700; margin-bottom:12px }
  .toolbar { width:72px; background:rgba(0,0,0,0.06); border-radius:14px; padding:12px; display:flex; flex-direction:column; gap:12px; align-items:center }
  .tool-icon { width:48px; height:48px; border-radius:50%; background:#fff; display:flex; align-items:center; justify-content:center; cursor:grab; box-shadow:0 6px 18px rgba(0,0,0,0.08) }
  .map-icon { position:absolute; width:40px; height:40px; border-radius:50%; background:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer; box-shadow:0 6px 18px rgba(0,0,0,0.12); transform:translate(-50%,-50%); }
  .map-icon.assigned { border:3px solid #57a773 }
  .tiny-panel { position:absolute; background:#fff; border-radius:8px; padding:8px; box-shadow:0 12px 40px rgba(0,0,0,0.2); z-index:4000 }
  .toast { position:fixed; right:18px; bottom:18px; background:#111; color:#fff; padding:10px 14px; border-radius:8px; opacity:0.95 }
</style>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px">
  <h2 style="margin:0">Office virtualization</h2>
  <div>
    <span class="office-pill"><%= h @office_slug %></span>
  </div>
</div>

<div class="office-map-wrap">
  <div style="flex:1">
    <div id="mapCanvas" class="map-canvas" role="application" aria-label="Office map">
      <div id="mapInner" style="position:absolute; inset:0; transform-origin:0 0;"></div>
      <div id="mapOverlay" style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none; color:#777">Drop icons here to place equipment</div>
    </div>
  </div>
  <aside style="width:180px; max-width:220px">
    <div style="display:flex; gap:12px; align-items:center; margin-bottom:8px"><strong>Available devices</strong></div>
    <div class="toolbar" id="toolbar" aria-label="Palette">
      <% # Fixed palette of common network / office devices so user can drag icons regardless of office inventory %>
      <% palette = ['Laptop','Desktop','Router','Switch','Printer'] %>
      <% palette.each do |t| %>
        <% ico = case t.downcase
                 when 'laptop' then '💻'
                 when 'desktop' then '🖥️'
                 when 'router' then '📡'
                 when 'switch' then '🔀'
                 when 'printer' then '🖨️'
                 else '🔘'
                 end %>
        <div class="tool-icon" draggable="true" data-type="<%= h t %>" title="<%= h t %>"><span style="font-size:18px"><%= ico %></span></div>
      <% end %>
      <div style="font-size:0.85rem;color:var(--muted);margin-top:8px;text-align:center">Drag icons onto the map</div>
    </div>
    <div style="margin-top:14px">
      <strong>Deployed equipment</strong>
      <div id="deployedList" style="margin-top:8px; max-height:380px; overflow:auto; background:transparent; padding-right:6px">
        <% @office_equipments.each do |eq| %>
          <div class="muted" data-eid="<%= eq.id %>"><%= h(eq.name) %> <span style="color:var(--muted)">(<%= h eq.serial_number %>)</span></div>
        <% end %>
      </div>
    </div>
  </aside>
</div>

<div id="toast" style="display:none" class="toast">Saved</div>

<script>
(function(){
  var canvas = document.getElementById('mapCanvas');
  var mapInner = document.getElementById('mapInner');
  var toolbar = document.getElementById('toolbar');
  var office = "<%= j @office_slug %>";
  var maps = { icons: [] };

  function showToast(msg){ var t = document.getElementById('toast'); t.innerText = msg; t.style.display='block'; setTimeout(function(){ t.style.display='none'; }, 1400); }

  function pct(x, total){ return Math.round((x/total)*10000)/100; }

  // transform state
  var scale = 1.0, tx = 0, ty = 0;
  function setTransform(){ mapInner.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + scale + ')'; }

  function screenToElementPixels(sx, sy){
    var rect = canvas.getBoundingClientRect();
    var preX = (sx - rect.left)/scale - tx;
    var preY = (sy - rect.top)/scale - ty;
    return { x: preX, y: preY };
  }

  function screenToPercent(sx, sy){
    var p = screenToElementPixels(sx, sy);
    var w = mapInner.offsetWidth || canvas.clientWidth;
    var h = mapInner.offsetHeight || canvas.clientHeight;
    return { x: (p.x / w) * 100, y: (p.y / h) * 100 };
  }

  function renderMaps(){
    mapInner.querySelectorAll('.map-icon').forEach(function(n){ n.remove(); });
    maps.icons.forEach(function(ic){
      var el = document.createElement('div');
      el.className = 'map-icon' + (ic.equipment_id ? ' assigned' : '');
      el.style.left = ic.x + '%'; el.style.top = ic.y + '%';
      el.dataset.id = ic.id; el.dataset.type = ic.type; el.title = ic.label || (ic.type || 'device');
      el.innerText = (ic.type || '').substr(0,2).toUpperCase();
      el.addEventListener('click', function(ev){ ev.stopPropagation(); openIconPanel(ic, el); });
      // pointer drag to reposition
      el.addEventListener('pointerdown', function(e){ if(e.button !== 0) return; e.preventDefault(); startIconDrag(e, ic, el); });
      mapInner.appendChild(el);
    });
    setTransform();
  }

  function openIconPanel(ic, el){
    document.querySelectorAll('.tiny-panel').forEach(function(n){ n.remove(); });
    var rect = el.getBoundingClientRect();
    var panel = document.createElement('div'); panel.className='tiny-panel';
    panel.style.left = (rect.right + 8) + 'px'; panel.style.top = (rect.top) + 'px';
    var html = '';
    html += '<div style="font-weight:700;margin-bottom:6px">' + (ic.label || (ic.type||'')) + '</div>';
    html += '<div style="margin-bottom:6px"><label>Link equipment:</label><br><input id="link_input" type="text" placeholder="serial or name" style="width:240px;padding:6px;border:1px solid #ccc;border-radius:6px"></div>';
    html += '<div style="display:flex;gap:8px;justify-content:flex-end"><button id="unlink_btn" class="btn-secondary">Unlink</button><button id="save_btn" class="btn-cta">Save</button></div>';
    panel.innerHTML = html; document.body.appendChild(panel); document.getElementById('link_input').focus();
    document.getElementById('save_btn').addEventListener('click', function(){ var v = document.getElementById('link_input').value.trim(); if(!v){ showToast('Enter serial or name to link'); return; } var found = Array.from(document.querySelectorAll('#deployedList [data-eid]')).map(function(n){ return { id: n.dataset.eid, text: n.innerText }; }).filter(function(x){ return x.text.toLowerCase().indexOf(v.toLowerCase()) !== -1; }); if(found.length>0){ ic.equipment_id = found[0].id; ic.label = found[0].text; saveMaps(); renderMaps(); panel.remove(); showToast('Linked'); } else { showToast('No matching equipment found'); } });
    document.getElementById('unlink_btn').addEventListener('click', function(){ ic.equipment_id = null; ic.label = null; saveMaps(); renderMaps(); panel.remove(); showToast('Unlinked'); });
  }

  // Icon drag helpers
  var iconDragState = null;
  function startIconDrag(e, ic, el){
    var start = { x: e.clientX, y: e.clientY, ic: ic };
    function onMove(ev){ ev.preventDefault(); var pctPos = screenToPercent(ev.clientX, ev.clientY); ic.x = Math.max(0, Math.min(100, pctPos.x)); ic.y = Math.max(0, Math.min(100, pctPos.y)); el.style.left = ic.x + '%'; el.style.top = ic.y + '%'; }
    function onUp(ev){ document.removeEventListener('pointermove', onMove); document.removeEventListener('pointerup', onUp); saveMaps(); showToast('Moved'); }
    document.addEventListener('pointermove', onMove); document.addEventListener('pointerup', onUp);
  }

  // Load existing map
  fetch('/api/deploy/office/' + encodeURIComponent(office) + '/map').then(function(r){ return r.json(); }).then(function(d){ maps = d || { icons: [] }; renderMaps(); }).catch(function(){ maps = { icons: [] }; renderMaps(); });

  // Toolbar pointer drag (works for touch and mouse)
  var activeGhost = null;
  function createGhost(type){ var g = document.createElement('div'); g.className='map-icon'; g.style.position='fixed'; g.style.pointerEvents='none'; g.style.width='48px'; g.style.height='48px'; g.style.left='0px'; g.style.top='0px'; g.innerText = (type||'').substr(0,2).toUpperCase(); document.body.appendChild(g); return g; }
  toolbar.addEventListener('pointerdown', function(e){ var t = e.target.closest && e.target.closest('.tool-icon'); if(!t) return; e.preventDefault(); var type = t.dataset.type; activeGhost = createGhost(type); function onMove(ev){ activeGhost.style.left = (ev.clientX - 24) + 'px'; activeGhost.style.top = (ev.clientY - 24) + 'px'; } function onUp(ev){ document.removeEventListener('pointermove', onMove); document.removeEventListener('pointerup', onUp); if(activeGhost){ var rect = canvas.getBoundingClientRect(); if(ev.clientX >= rect.left && ev.clientX <= rect.right && ev.clientY >= rect.top && ev.clientY <= rect.bottom){ var pctPos = screenToPercent(ev.clientX, ev.clientY); var nid = 'ic_' + (Date.now()) + '_' + Math.floor(Math.random()*1000); maps.icons.push({ id: nid, type: type, x: pctPos.x, y: pctPos.y, equipment_id: null, label: null }); renderMaps(); saveMaps(); showToast('Placed'); } activeGhost.remove(); activeGhost = null; } document.addEventListener('pointermove', onMove); document.addEventListener('pointerup', onUp); });

  // Canvas pan & pinch-zoom
  var pointerState = { pointers: {}, lastPan: null, pinch: null };
  canvas.addEventListener('pointerdown', function(e){ canvas.setPointerCapture && canvas.setPointerCapture(e.pointerId); pointerState.pointers[e.pointerId] = e; if(Object.keys(pointerState.pointers).length === 1){ pointerState.lastPan = { x: e.clientX, y: e.clientY, tx: tx, ty: ty }; } if(Object.keys(pointerState.pointers).length === 2){ var ps = Object.values(pointerState.pointers); var a = ps[0], b = ps[1]; var dx = b.clientX - a.clientX, dy = b.clientY - a.clientY; pointerState.pinch = { dist: Math.hypot(dx,dy), midX: (a.clientX+b.clientX)/2, midY: (a.clientY+b.clientY)/2, startScale: scale, startTx: tx, startTy: ty }; } });

  canvas.addEventListener('pointermove', function(e){ if(!pointerState.pointers[e.pointerId]) return; pointerState.pointers[e.pointerId] = e; if(pointerState.pinch){ var ps = Object.values(pointerState.pointers); if(ps.length < 2) return; var a = ps[0], b = ps[1]; var dx = b.clientX - a.clientX, dy = b.clientY - a.clientY; var newDist = Math.hypot(dx,dy); var ns = pointerState.pinch.startScale * (newDist / pointerState.pinch.dist); ns = Math.max(0.25, Math.min(3, ns)); var midX = (a.clientX + b.clientX)/2, midY = (a.clientY + b.clientY)/2; var pre = screenToElementPixels(midX, midY); var s2 = ns; var rect = canvas.getBoundingClientRect(); var tx2 = ( (midX - rect.left) / s2 ) - pre.x; var ty2 = ( (midY - rect.top) / s2 ) - pre.y; scale = s2; tx = tx2; ty = ty2; setTransform(); } else if(pointerState.lastPan && Object.keys(pointerState.pointers).length === 1){ var ev = e; var dx = ev.clientX - pointerState.lastPan.x; var dy = ev.clientY - pointerState.lastPan.y; tx = pointerState.lastPan.tx + dx/scale; ty = pointerState.lastPan.ty + dy/scale; setTransform(); } });

  canvas.addEventListener('pointerup', function(e){ try{ canvas.releasePointerCapture && canvas.releasePointerCapture(e.pointerId); }catch(_){} delete pointerState.pointers[e.pointerId]; pointerState.lastPan = null; pointerState.pinch = null; });

  // wheel zoom (desktop)
  canvas.addEventListener('wheel', function(e){ e.preventDefault(); var delta = -e.deltaY; var zoomFactor = delta > 0 ? 1.08 : 0.92; var s2 = Math.max(0.25, Math.min(3, scale * zoomFactor)); var rect = canvas.getBoundingClientRect(); var pre = screenToElementPixels(e.clientX, e.clientY); var tx2 = ( (e.clientX - rect.left) / s2 ) - pre.x; var ty2 = ( (e.clientY - rect.top) / s2 ) - pre.y; scale = s2; tx = tx2; ty = ty2; setTransform(); }, { passive: false });

  // Save maps to server
  function saveMaps(){ fetch('/api/deploy/office/' + encodeURIComponent(office) + '/map', { method: 'POST', headers: { 'Content-Type':'application/json' }, body: JSON.stringify(maps) }).then(function(r){ if(r.ok) showToast('Saved'); else showToast('Save failed'); }).catch(function(){ showToast('Save failed'); }); }

  // click outside to remove tiny panels
  document.addEventListener('click', function(ev){ if(!ev.target.closest('.tiny-panel')){ document.querySelectorAll('.tiny-panel').forEach(function(n){ n.remove(); }); } });

})();
</script>
