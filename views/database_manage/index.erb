<div class="card form-card">
  <h2>Database Manage</h2>

  <% if @error %>
    <div class="flash" style="background:rgba(255,107,107,0.12); color:#ffdede"><%= h @error %></div>
  <% end %>
  <% if @success %>
    <div class="flash" style="background:linear-gradient(90deg, rgba(154,234,106,0.12), rgba(138,200,255,0.06)); color:#dff8c6"><%= h @success %></div>
  <% end %>

  <div style="margin-bottom:18px">
    <p>Use these tools to export the full database to a JSON file or import a previously exported JSON file. Only super-admins can perform these actions.</p>
  </div>

  <div style="margin-bottom:18px">
    <h3>Legacy DB expiry & automatic export</h3>
    <form method="post" action="/database_manage/set_expiry" style="margin-bottom:8px">
      <label for="expiry_date">Legacy DB expiry date (UTC):</label>
      <input id="expiry_date" name="expiry_date" type="date" value="<%= @expiry_date %>" />
      <button class="btn-secondary" type="submit">Save expiry</button>
    </form>
    <% if @expiry_status %>
      <div style="color:var(--muted)"><%= h @expiry_status %></div>
    <% end %>
    <% if @auto_export_file %>
      <div style="margin-top:8px">
        <strong>Auto-export created:</strong>
        <a href="/database_manage/download/<%= URI::DEFAULT_PARSER.escape(@auto_export_file) %>"><%= h @auto_export_file %></a>
      </div>
    <% end %>
    <% if @exports && @exports.any? %>
      <div style="margin-top:8px">
        <strong>Available exports:</strong>
        <ul>
          <% @exports.each do |f| %>
            <li><a href="/database_manage/download/<%= URI::DEFAULT_PARSER.escape(f) %>"><%= h f %></a></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <div style="display:flex; gap:12px; align-items:center; margin-bottom:16px">
    <form method="get" action="/database_manage/export">
      <button class="btn-cta" type="submit">Export Database (JSON)</button>
    </form>
    <form method="post" action="/database_manage/run_backup">
      <% if defined?(@days_left) && !@days_left.nil? %>
        <% if @days_left > 1 %>
          <% label = "#{@days_left} days left" %>
        <% elsif @days_left == 1 %>
          <% label = "1 day left" %>
        <% elsif @days_left == 0 %>
          <% label = "Due today" %>
        <% else %>
          <% label = "Expired" %>
        <% end %>
        <button class="btn-cta" type="submit">Run automatic backup (<%= h label %>)</button>
      <% else %>
        <button class="btn-cta" type="submit">Run automatic backup</button>
      <% end %>
    </form>
    <form method="post" action="/database_manage/import" enctype="multipart/form-data">
      <label for="dbfile" style="display:inline-block; margin-right:8px">Import JSON file</label>
      <input id="dbfile" name="file" type="file" accept="application/json" style="color:var(--muted)" />
      <button class="btn-secondary" type="submit">Upload & Import</button>
    </form>
  </div>

  <div style="font-size:0.9rem; color:var(--muted)">
    <strong>Notes:</strong>
    <ul>
      <li>Export creates a JSON object mapping table names to arrays of row objects.</li>
      <li>Import will truncate destination tables (except schema migrations) and insert rows from the file. <strong>Back up before importing.</strong></li>
      <li>This is intended for migrations between accounts or backups. Large databases may produce large files.</li>
    </ul>
  </div>
</div>
